# =============================================================================
# HashKey Chain Testnet — 联调模板
#
# 用法：
#   cp .env.hashkey.testnet.example .env.hashkey.testnet
#   填入密钥、ESCROW、DATABASE_URL 等；或 bash scripts/switch-env.sh hashkey
#
# 约定：CHAIN_ID=133，RPC=https://testnet.hsk.xyz；USDC 仅使用下方合约地址，
#       勿与 Base Sepolia / Anvil Mock 混用。详见 docs/CHECKLIST-env-hashkey-local-neon.md
# 密钥勿提交；.env.hashkey.testnet 已 gitignore。
# =============================================================================

# -----------------------------------------------------------------------------
# Chain
# -----------------------------------------------------------------------------
CHAIN_ID=133
CHAIN_RPC_URL=https://testnet.hsk.xyz
CHAIN_NETWORK=hashkey-testnet

# -----------------------------------------------------------------------------
# API / 支付回跳（服务端）
#
# BASE_URL = 前端站点根 URL（用于 redirect_url = ${BASE_URL}/payment/result?intentId=...）
#   勿填 API 域名（:8787）；本地前端一般为 http://127.0.0.1:3000
# HASHKEY_REDIRECT_URL 若设置会覆盖 BASE_URL（一般本地联调保持留空/注释）
# -----------------------------------------------------------------------------
BASE_URL=

# HASHKEY_REDIRECT_URL=

# -----------------------------------------------------------------------------
# Database（可选；未设置则内存演示）
# Neon 等 URL 含 & 时，若用 source .env 加载请用单引号包裹整段值
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# On-chain（须与 CHAIN_ID=133 同源）
# USDC 须与前端 NEXT_PUBLIC_USDC_CONTRACT 一致
# -----------------------------------------------------------------------------
USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6

# PayFiEscrow：在 Chain 133 部署后填入
ESCROW_ADDRESS=

# -----------------------------------------------------------------------------
# HashKey Merchant Gateway
# -----------------------------------------------------------------------------
HASHKEY_BASE_URL=https://merchant-qa.hashkeymerchant.com
APP_KEY=
APP_SECRET=
# 空则后端回退为 APP_KEY
HASHKEY_MERCHANT_ID=
HASHKEY_JWT_AUD=hgatepay
MERCHANT_PRIVATE_KEY_PEM=
MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
MERCHANT_NAME=payfidemo

# -----------------------------------------------------------------------------
# 链上交易提交账户（submitter / release / refund）；勿提交真实私钥到仓库
# -----------------------------------------------------------------------------
SUBMITTER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Explorer / Webhook / 功能开关
# -----------------------------------------------------------------------------
BLOCKSCOUT_URL=https://testnet-explorer.hsk.xyz
WEBHOOK_TIMEOUT_MS=
X402_ENABLED=false
PAYFIDEMO_DEBUG=false

# -----------------------------------------------------------------------------
# 前端（Next.js：可写入 frontend/.env.local，须与上方链与 USDC 一致）
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYFI_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_CHAIN_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi 托管演示（HashKey Chain Testnet）
