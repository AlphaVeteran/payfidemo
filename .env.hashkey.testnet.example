# =============================================================================
# HashKey Chain Testnet — 联调专用（勿与其它网络混用）
#
# 约定（写死在本文件，复制到 .env.hashkey.testnet 后勿改链/代币地址除非官方更换）：
#   1) 链：CHAIN_ID=133，RPC=https://testnet.hsk.xyz，CHAIN_NETWORK=hashkey-testnet
#   2) USDC：仅使用 HashKey 测试网浏览器已验证的 USD Coin（FiatTokenProxy，6 decimals）
#      合约地址 0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6 — 勿与 Base Sepolia / Anvil Mock 等资产混用
#   3) PayFiEscrow：ESCROW_ADDRESS 必须是在上述同一网络（133）上部署的合约
#
# 使用：cp .env.hashkey.testnet.example .env.hashkey.testnet 后填入密钥与 ESCROW；
#       或 bash scripts/switch-env.sh hashkey（首次会从本文件生成 .env.hashkey.testnet）
# 密钥类勿提交；.env.hashkey.testnet 默认 gitignore。
# 详见 docs/CHECKLIST-env-hashkey-local-neon.md
# =============================================================================

CHAIN_ID=133
CHAIN_RPC_URL=https://testnet.hsk.xyz
CHAIN_NETWORK=hashkey-testnet

# 可选：仅终端 curl 冒烟；服务端监听端口由 PORT 决定
BASE_URL=

DATABASE_URL=

# --- 以下为 HashKey Testnet 唯一 USDC（与前端 NEXT_PUBLIC_USDC_CONTRACT 必须一致）---
USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6

# PayFiEscrow：在 Chain 133 上部署后填入（勿填 Base Sepolia 或其它链地址）
ESCROW_ADDRESS=

# HashKey Merchant Gateway
HASHKEY_BASE_URL=https://merchant-qa.hashkeymerchant.com
APP_KEY=
APP_SECRET=
HASHKEY_MERCHANT_ID=
HASHKEY_JWT_AUD=hgatepay
MERCHANT_PRIVATE_KEY_PEM=
MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
MERCHANT_NAME=payfidemo

SUBMITTER_PRIVATE_KEY=

BLOCKSCOUT_URL=https://testnet-explorer.hsk.xyz
WEBHOOK_TIMEOUT_MS=
X402_ENABLED=false
PAYFIDEMO_DEBUG=false

# --- 前端（须与上方 CHAIN_ID / USDC 同源）---
NEXT_PUBLIC_PAYFI_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_CHAIN_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi 托管演示（HashKey Chain Testnet）
