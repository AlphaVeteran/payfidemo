# =============================================================================
# HashKey Chain Testnet — 前端专用（与仓库根目录 .env.hashkey.testnet.example 同源）
# 复制为 frontend/.env.local 或合并进现有 .env.local；勿与 Anvil / Base Sepolia 混用。
# =============================================================================
NEXT_PUBLIC_PAYFI_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_CHAIN_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet-explorer.hsk.xyz

# 首页 HashKey 卡片展示：须与后端 ESCROW_ADDRESS、HASHKEY_BASE_URL 一致
NEXT_PUBLIC_ESCROW_ADDRESS=0xa16759b0b5bc1f19211552ec5550e09866523b44
NEXT_PUBLIC_HASHKEY_MERCHANT_GATEWAY_URL=https://merchant-qa.hashkeymerchant.com

# 新建意向表单默认商家地址（可选；与后端演示商户一致时再填）
# NEXT_PUBLIC_DEMO_MERCHANT=0x506547F10fFe97eBfcBC4F4f9604B5486337B985

# 新建托管意向表单缺省（可选；未设置时分别为 10 / 5 / 1）
# NEXT_PUBLIC_DEFAULT_ESCROW_USDC=10
# NEXT_PUBLIC_DEFAULT_MAX_RELEASES=5
# NEXT_PUBLIC_DEFAULT_CYCLE_HOURS=1
