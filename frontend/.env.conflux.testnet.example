# =============================================================================
# Conflux Testnet（eSpace chainId 71）— 前端专用
#
# 浏览器钱包请连接 Conflux eSpace Testnet；Core Space（chainId 1）由 Fluent / 跨空间脚本使用。
# 复制为 frontend/.env.local 或合并进现有 .env.local；修改 NEXT_PUBLIC_* 后需重启 next dev。
#
# 须与仓库根目录在 conflux-testnet 模式下保持一致（CHAIN_ID=71、ESCROW_ADDRESS、USDC_CONTRACT 等）：
#   .env.conflux.testnet.example · bash scripts/switch-env.sh conflux-testnet
# 下方地址来自 README「Deployed contracts」示例，部署后请改为你的合约地址。
# =============================================================================

# 本地 API（无尾斜杠）；线上部署时改为 https://你的 API 根地址
NEXT_PUBLIC_PAYFI_API_URL=http://localhost:8787

# eSpace Testnet — 与 MetaMask / wagmi 一致
NEXT_PUBLIC_CHAIN_ID=71
NEXT_PUBLIC_CHAIN_RPC_URL=https://evmtestnet.confluxrpc.com

# eSpace 浏览器（用于「查看交易」等；勿带末尾 /）
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://evmtestnet.confluxscan.org

# 新建意向默认资产（推荐新变量）：须与根目录 USDC_CONTRACT 及链上 PayFiEscrow 入金代币一致
# 支持 USDC / USDT0 / AxCNH 等稳定币叙事（实际地址请按同网同合约能力配置）
NEXT_PUBLIC_DEMO_ASSET_SYMBOL=AxCNH
NEXT_PUBLIC_DEMO_ASSET_ADDRESS=0x680E3dbf8fDBb8518969F0d4b1DC4ae9b55685ca
NEXT_PUBLIC_DEMO_ASSET_DECIMALS=6
# 兼容旧变量（未设置 NEXT_PUBLIC_DEMO_ASSET_ADDRESS 时回退）
NEXT_PUBLIC_USDC_CONTRACT=0x680E3dbf8fDBb8518969F0d4b1DC4ae9b55685ca

# PayFiEscrow — 须与根目录 ESCROW_ADDRESS 一致
NEXT_PUBLIC_ESCROW_ADDRESS=0x44898c384Af98dBB3666E0c0dD9dA643547863a6

# 新建意向表单默认商家地址（可选；双签演示时需与商家侧钱包一致）
NEXT_PUBLIC_DEMO_MERCHANT=0x4905290E3450761D7aF0FdfdC01f89a2ea5369c9

# 新建托管意向表单缺省（可选；未设置时分别为 10 / 5 / 1）
NEXT_PUBLIC_DEMO_AMOUNT_TOTAL=90
# 兼容旧变量（未设置 NEXT_PUBLIC_DEFAULT_ESCROW_ASSET 时回退）
NEXT_PUBLIC_DEFAULT_ESCROW_USDC=900
NEXT_PUBLIC_DEFAULT_MAX_RELEASES=3
NEXT_PUBLIC_DEFAULT_CYCLE_HOURS=1

# 可选：layout metadata
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi demo (Conflux eSpace Testnet)

# -----------------------------------------------------------------------------
# Cross-Space 首页展示（设为 true 时首页显示 Core / eSpace 合约卡片；仅 Conflux 部署时打开）
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CROSS_SPACE_ENABLED=true
# 可选：前端轮询 cross-space demo 任务的最长等待（毫秒），须大于 API 的 CROSS_SPACE_DEMO_TIMEOUT_MS；默认 2100000（35 分钟）
# NEXT_PUBLIC_CROSS_SPACE_DEMO_CLIENT_POLL_MAX_MS=2100000

# Core Space Testnet 固定为 1（Conflux Core 网络标识，勿与 Ethereum Mainnet 的 chainId=1 混淆）
NEXT_PUBLIC_CORESPACE_CHAIN_ID=1
# Core Space 浏览器根 URL（勿带末尾 /）；合约页一般为 /address/0x...
NEXT_PUBLIC_CORESPACE_EXPLORER_BASE_URL=https://testnet.confluxscan.net
# 可选：若 Core 浏览器地址规则与 /address/0x... 不兼容，可直接指定完整合约链接覆盖
# NEXT_PUBLIC_CORE_ORDER_VAULT_EXPLORER_URL=https://testnet.confluxscan.net/address/cfx:...

# CoreOrderVault：推荐填写 Core Space 的 cfxtest/cfx 地址（首页展示与跳转优先使用）
NEXT_PUBLIC_CORE_ORDER_VAULT_CFX_ADDRESS=cfxtest:...
# 可选兼容：若你仍有旧字段，可保留 0x 地址作为回退
# NEXT_PUBLIC_CORE_ORDER_VAULT_ADDRESS=0x...
# Core Space 单独部署的 MockERC20（与 eSpace 上 0x680E… 不是同一合约；部署后填入 cfxtest:… 或 0x）
# npm run deploy:core-space:mock-erc20（须先 forge build，并配置 CORE_RPC_URL + 私钥）
NEXT_PUBLIC_CORE_MOCK_ERC20_ADDRESS=cfxtest:acazrp5f7ff2cnj3w669k8up07wbk7j6cpvsn9sjrc
# 同一 Core MockERC20 的 hex 地址（供 wallet_watchAsset / EVM 地址校验场景）
NEXT_PUBLIC_CORE_MOCK_ERC20_HEX_ADDRESS=0x8156b365e94b812d199739f4fa0cb76414f51c13
# Fluent wallet_watchAsset 会校验链上 symbol/decimals；须与部署一致（deploy-mock-erc20-core-space 默认 MOCK / 18）
# NEXT_PUBLIC_CORE_MOCK_ERC20_SYMBOL=MOCK
# NEXT_PUBLIC_CORE_MOCK_ERC20_DECIMALS=18
# 可选回退：未设置上一项时使用（旧配置兼容）
# NEXT_PUBLIC_CORE_DEPOSIT_ASSET_ADDRESS=
# 可选：浏览器合约页完整 URL（与 CoreOrderVault 一样，当 /address/ 规则不适用时）
# NEXT_PUBLIC_CORE_MOCK_ERC20_EXPLORER_URL=https://testnet.confluxscan.net/address/cfxtest:...

NEXT_PUBLIC_ESPACE_CHAIN_ID=71
# 与 NEXT_PUBLIC_ESCROW_ADDRESS 一致时可省略；若单独展示托管合约可显式填写
NEXT_PUBLIC_PAYFI_ESCROW_ADDRESS=0x44898c384Af98dBB3666E0c0dD9dA643547863a6
NEXT_PUBLIC_ESPACE_ADAPTER_ADDRESS=0x8d7d93043768f863DcCAbD0B9c4189222fFc1d38
