# Base Sepolia 完整前端模板见：frontend/.env.base.sepolia.example
# HashKey Testnet 完整前端模板见：frontend/.env.hashkey.testnet.example
# Conflux Testnet（eSpace 71）完整前端模板见：frontend/.env.conflux.testnet.example
#
# PayFi API 根地址（无尾斜杠）
# 本地：http://127.0.0.1:8787
# Railway：先部署根目录 API 服务，再填其公网 URL，例如 https://payfidemo-api.up.railway.app
NEXT_PUBLIC_PAYFI_API_URL=http://127.0.0.1:8787

# Network target (default: local Anvil)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_RPC_URL=http://127.0.0.1:8545

# Optional: switch to Base Sepolia (chainId=84532)
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia.base.org

# Optional fallback for Base Sepolia RPC (used only when you enable baseSepolia)
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Sepolia：新建意图时的 merchant（user 使用当前连接钱包）。不设则仍为 Anvil 演示商家地址。
# NEXT_PUBLIC_DEMO_MERCHANT=0xYourMerchantTestAddress
