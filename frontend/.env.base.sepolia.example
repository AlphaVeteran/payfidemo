# =============================================================================
# Base Sepolia（chainId 84532）— 前端专用
# 与仓库根目录 .env.base.sepolia.example 中 NEXT_PUBLIC_* / 链上展示字段一致。
# 复制为 frontend/.env.local 或合并进现有 .env.local；勿与 Anvil / HashKey Testnet 混用。
# 完整后端变量见根目录 .env.base.sepolia.example 或 bash scripts/switch-env.sh base-sepolia
# =============================================================================

# 本地 Next 与 API 同机时建议用 localhost，避免浏览器拦截 localhost→127.0.0.1
NEXT_PUBLIC_PAYFI_API_URL=http://localhost:8787
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Demo Asset（推荐新变量）
NEXT_PUBLIC_DEMO_ASSET_SYMBOL=USDC
NEXT_PUBLIC_DEMO_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_DEMO_ASSET_DECIMALS=6
# 兼容旧变量（未设置 NEXT_PUBLIC_DEMO_ASSET_ADDRESS 时回退）
NEXT_PUBLIC_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# 须与根目录 ESCROW_ADDRESS、链上部署一致
NEXT_PUBLIC_ESCROW_ADDRESS=0x3FCE185FFF78dDB1120C606A0611e168646a0CeA

# 新建意向表单默认商家地址（可选；双签时需对应商家私钥）
NEXT_PUBLIC_DEMO_MERCHANT=0x506547F10fFe97eBfcBC4F4f9604B5486337B985

# 新建托管意向表单缺省（可选；未设置时分别为 10 / 5 / 1）
NEXT_PUBLIC_DEFAULT_ESCROW_ASSET=1
# 兼容旧变量（未设置 NEXT_PUBLIC_DEFAULT_ESCROW_ASSET 时回退）
NEXT_PUBLIC_DEFAULT_ESCROW_USDC=1
NEXT_PUBLIC_DEFAULT_MAX_RELEASES=2
NEXT_PUBLIC_DEFAULT_CYCLE_HOURS=1

# 可选：layout metadata
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi demo (Base Sepolia)
