# =============================================================================
# Base Sepolia — 联调模板（chainId 84532）
#
# 用法：
#   cp .env.base.sepolia.example .env.base.sepolia
#   填入 SUBMITTER_PRIVATE_KEY、DATABASE_URL 等；或 bash scripts/switch-env.sh base-sepolia
#
# 约定：CHAIN_ID=84532；USDC 使用 Circle 测试 USDC，勿与 HashKey Testnet / Anvil 混用。
# 详见 docs/railway-base-sepolia-deploy.md
# 密钥勿提交；.env.base.sepolia 已 gitignore。
# =============================================================================

# -----------------------------------------------------------------------------
# Chain
# -----------------------------------------------------------------------------
CHAIN_ID=84532
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_NETWORK=base-sepolia

# -----------------------------------------------------------------------------
# API / 支付回跳（服务端）
# -----------------------------------------------------------------------------
BASE_URL=

# -----------------------------------------------------------------------------
# Database（可选；未设置则内存演示）
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# On-chain（须与 CHAIN_ID=84532 同源）
# Circle Base Sepolia 测试 USDC（6 decimals）
# -----------------------------------------------------------------------------
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# PayFiEscrow（仓库历史部署示例；可改为自部署地址）
ESCROW_ADDRESS=0x3FCE185FFF78dDB1120C606A0611e168646a0CeA

# -----------------------------------------------------------------------------
# HashKey Merchant Gateway（Base 演示可不填；若走 HashKey 收银台再配置）
# -----------------------------------------------------------------------------
HASHKEY_BASE_URL=https://merchant-qa.hashkeymerchant.com
APP_KEY=
APP_SECRET=
HASHKEY_MERCHANT_ID=
HASHKEY_JWT_AUD=hgatepay
MERCHANT_PRIVATE_KEY_PEM=
MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
MERCHANT_NAME=payfidemo

# -----------------------------------------------------------------------------
# 链上交易提交账户（submitter / release / refund）；勿提交真实私钥到仓库
# -----------------------------------------------------------------------------
SUBMITTER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Explorer / Webhook / 功能开关
# -----------------------------------------------------------------------------
BLOCKSCOUT_URL=https://sepolia.basescan.org
WEBHOOK_TIMEOUT_MS=
X402_ENABLED=false
PAYFIDEMO_DEBUG=false

# -----------------------------------------------------------------------------
# 前端（Next.js：可写入 frontend/.env.local，须与上方链与 USDC 一致）
# 前端专用模板：frontend/.env.base.sepolia.example
# -----------------------------------------------------------------------------
# 本地 Next 用 localhost 打开时，请与 API 同用 localhost，避免浏览器拦截 localhost→127.0.0.1
NEXT_PUBLIC_PAYFI_API_URL=http://localhost:8787
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi demo (Base Sepolia)
