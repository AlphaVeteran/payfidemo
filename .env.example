# 通用示例（多网络字段混排）。HashKey Chain Testnet 联调请优先使用已钉死链/USDC 的：
#   .env.hashkey.testnet.example  → 复制为 .env.hashkey.testnet 或 bash scripts/switch-env.sh hashkey

# HashKey testnet（本分支默认联调）
CHAIN_ID=133
CHAIN_RPC_URL=https://testnet.hsk.xyz
CHAIN_NETWORK=hashkey-testnet

# 可选：部署后的 API 根 URL（仅方便本机终端 `source .env` 后写 `curl "$BASE_URL/health"` 等冒烟命令）。
# 服务端不读取此变量；Railway/本地实际监听端口由 PORT 决定。勿带末尾 `/`，勿含 `/api/...` 路径。
# 本地示例：http://127.0.0.1:8787 · 远端示例：https://your-service.up.railway.app
BASE_URL=

# 可选：设置后 intents 与 settlement outbox 持久化到 Postgres（未设置则内存演示）
# 可与其它分支共用同一 Neon 项目，例如：https://console.neon.tech/app/projects/tiny-fog-29141407
# 本地示例：postgres://user:pass@127.0.0.1:5432/payfidemo
# 若用 `source .env` 加载：URL 中含 &（如 Neon 的 channel_binding）时须用单引号包裹整段值
DATABASE_URL=

# USDC on HashKey Chain Testnet（测试网浏览器验证：USD Coin / FiatTokenProxy，6 decimals）
USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6

# Escrow：HashKey 测试网部署后填入。Base Sepolia 演示示例（与 main / WORKLOG 一致）：
# https://sepolia.basescan.org/address/0x3FCE185FFF78dDB1120C606A0611e168646a0CeA
ESCROW_ADDRESS=

# Base Sepolia 上创建 intent 的 asset 请与 Circle 测试 USDC 一致（6 decimals）：
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e · https://developers.circle.com/stablecoins/usdc-contract-addresses

# HashKey Merchant Gateway
HASHKEY_BASE_URL=https://merchant-qa.hashkeymerchant.com
APP_KEY=
APP_SECRET=
# Optional override for top-level request field `merchant_id` in reusable order API.
# If empty, backend falls back to APP_KEY.
HASHKEY_MERCHANT_ID=
# Optional override for merchant_authorization JWT aud claim.
# HashKey QA sample uses hgatepay.
HASHKEY_JWT_AUD=hgatepay
# Optional inline private key PEM for cloud deploys (recommended on Railway).
# If set, backend uses this value and ignores MERCHANT_PRIVATE_KEY_PATH.
# Keep escaped newlines in one line, e.g. "-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
MERCHANT_PRIVATE_KEY_PEM=
MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
MERCHANT_NAME=payfidemo

# Optional: public URL of this API (no trailing slash). Used as `${BASE_URL}/payment/result?intentId=<uuid>` when HASHKEY_REDIRECT_URL is unset.
# 服务端会在该回跳 URL 上追加 `intentId`（与创建意向一致），支付完成后网关可再追加 tx_hash 等；前端 `/payment/result` 自动 POST funding/tx。
# For HashKey QA, prefer https (ngrok) or set HASHKEY_REDIRECT_URL explicitly.
# BASE_URL=https://your-ngrok-host.example

# Optional: overrides BASE_URL for HashKey createReusableOrder redirect after checkout（同样会追加 `?intentId=`）。
# HASHKEY_REDIRECT_URL=https://your-ngrok-host.example/payment/result

# OKX Wallet / 演示账户
# 仅用于发起 on-chain 交易（submitter/release/refund）。请勿提交真实私钥。
SUBMITTER_PRIVATE_KEY=

# Blockscout（HashKey Testnet；主网见文档 https://hashkey.blockscout.com）
BLOCKSCOUT_URL=https://testnet-explorer.hsk.xyz

# Webhook：对外 POST 商户 webhookUrl 时的超时（毫秒），默认 15000，范围 1000–120000
WEBHOOK_TIMEOUT_MS=

# Optional: x402 later
X402_ENABLED=false

# 设为 true 时开放 POST /api/payfi/v1/debug/intents/:id/expire（仅本地）
PAYFIDEMO_DEBUG=false

NEXT_PUBLIC_PAYFI_API_URL=https://payfidemo-api-hashkey-qa.up.railway.app
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_CHAIN_RPC_URL=https://testnet.hsk.xyz
# 与后端 USDC_CONTRACT 一致（创建意向默认 asset）
NEXT_PUBLIC_USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
# 区块浏览器根 URL（用于「查看交易」链接；HashKey Testnet 官方 Blockscout）
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# 可选：覆盖 layout metadata description
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi 托管演示（HashKey Chain Testnet）

# 可选：用户页「新建托管合同意向」表单缺省（未设置时分别为 10 USDC / 5 期 / 1 小时）
# NEXT_PUBLIC_DEFAULT_ESCROW_USDC=10
# NEXT_PUBLIC_DEFAULT_MAX_RELEASES=5
# NEXT_PUBLIC_DEFAULT_CYCLE_HOURS=1