# Local API
PORT=8787

# Chain: Anvil 本地默认 31337；Base Sepolia 为 84532
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545

# Escrow（forge script 部署后填入）
ESCROW_ADDRESS=

# deployer/relayer 账户私钥（建议与用户账户分离；Anvil 测试私钥，勿用于主网）
DEPLOYER_PRIVATE_KEY=

# 代发 release/refund 交易的账户私钥；留空时会回退使用 DEPLOYER_PRIVATE_KEY
SUBMITTER_PRIVATE_KEY=

# 角色私钥（仅本地；与 intent.user / intent.merchant 对应。页面复制的 cast / sign-release 会读这些变量）
# Anvil 默认：#0 用户 0xf39F… / #1 商家 0x7099…
USER_PRIVATE_KEY=
MERCHANT_PRIVATE_KEY=

# Optional: x402 later
X402_ENABLED=false

# 设为 true 时开放 POST /api/payfi/v1/debug/intents/:id/expire（仅本地）
PAYFIDEMO_DEBUG=false
