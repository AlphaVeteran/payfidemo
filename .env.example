# =============================================================================
# PayFi Demo — 环境变量示例（复制为 .env 后按需填写）
# =============================================================================
# HashKey Chain Testnet 专一配置：.env.hashkey.testnet.example
#   复制为 .env.hashkey.testnet，或执行：bash scripts/switch-env.sh hashkey
# =============================================================================

# -----------------------------------------------------------------------------
# Chain（本仓库默认联调：HashKey Testnet）
# -----------------------------------------------------------------------------
CHAIN_ID=133
CHAIN_RPC_URL=https://testnet.hsk.xyz
CHAIN_NETWORK=hashkey-testnet

# -----------------------------------------------------------------------------
# 服务与存储
# -----------------------------------------------------------------------------
# 可选：部署后的 API 根 URL（仅方便本机 source .env 后 curl 冒烟）。
# 服务端不读取；实际端口由 PORT 决定。勿带末尾 /，勿含 /api/...。
# 例：http://127.0.0.1:8787 · https://your-service.up.railway.app
BASE_URL=

# 可选：intents 与 settlement outbox 持久化到 Postgres；未设置则内存演示。
# 例：postgres://user:pass@127.0.0.1:5432/payfidemo
# Neon 等 URL 含 & 时，若 source .env 加载须用单引号包住整段值。
DATABASE_URL=

# Webhook：对外 POST 商户 webhookUrl 超时（毫秒）。默认 15000，范围 1000–120000。
WEBHOOK_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# 合约与资产
# -----------------------------------------------------------------------------
# USDC — HashKey Chain Testnet（USD Coin / FiatTokenProxy，6 decimals）
USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6

# Escrow：HashKey 测试网部署后填入。
# Base Sepolia 示例：https://sepolia.basescan.org/address/0x3FCE185FFF78dDB1120C606A0611e168646a0CeA
ESCROW_ADDRESS=

# Base Sepolia 上 intent 的 asset 需与 Circle 测试 USDC 一致（6 decimals）：
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e

# -----------------------------------------------------------------------------
# HashKey Merchant Gateway
# -----------------------------------------------------------------------------
HASHKEY_BASE_URL=https://merchant-qa.hashkeymerchant.com
APP_KEY=
APP_SECRET=

# 可选：可复用下单 API 顶层字段 merchant_id。空则回退为 APP_KEY。
HASHKEY_MERCHANT_ID=

# 可选：merchant_authorization JWT 的 aud。HashKey QA 示例为 hgatepay。
HASHKEY_JWT_AUD=hgatepay

# 可选：商户 EC 私钥 PEM（云部署推荐）。若设置则忽略 MERCHANT_PRIVATE_KEY_PATH。
# 单行转义换行，例："-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
MERCHANT_PRIVATE_KEY_PEM=
MERCHANT_PRIVATE_KEY_PATH=./keys/merchant_private_key.pem
MERCHANT_NAME=payfidemo

# -----------------------------------------------------------------------------
# 支付完成回跳（HashKey createReusableOrder）
# -----------------------------------------------------------------------------
# 可选：本 API 公网根 URL（无尾斜杠）。HASHKEY_REDIRECT_URL 未设时用于
# ${BASE_URL}/payment/result?intentId=<uuid>。HashKey QA 建议 https（ngrok）或显式设 HASHKEY_REDIRECT_URL。
# BASE_URL=https://your-ngrok-host.example

# 可选：覆盖上述，用于 checkout 后回跳（同样会追加 ?intentId=）。
# HASHKEY_REDIRECT_URL=https://your-ngrok-host.example/payment/result

# -----------------------------------------------------------------------------
# 链上操作与浏览器
# -----------------------------------------------------------------------------
# 仅用于 submitter 发起交易（submitter/release/refund）。勿提交真实私钥。
SUBMITTER_PRIVATE_KEY=

# Blockscout（HashKey Testnet；主网见 https://hashkey.blockscout.com）
BLOCKSCOUT_URL=https://testnet-explorer.hsk.xyz

# -----------------------------------------------------------------------------
# 功能开关
# -----------------------------------------------------------------------------
# 预留：x402
X402_ENABLED=false

# true 时开放 POST /api/payfi/v1/debug/intents/:id/expire（仅本地）
PAYFIDEMO_DEBUG=false

# =============================================================================
# 前端（NEXT_PUBLIC_* 构建时注入）
# =============================================================================
NEXT_PUBLIC_PAYFI_API_URL=https://payfidemo-api-hashkey-qa.up.railway.app
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_CHAIN_RPC_URL=https://testnet.hsk.xyz

# 与后端 USDC_CONTRACT 一致（创建意向默认 asset）
NEXT_PUBLIC_USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6

# 「查看交易」链接根 URL（HashKey Testnet Blockscout）
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet-explorer.hsk.xyz

# 可选：layout metadata description
# NEXT_PUBLIC_SITE_DESCRIPTION=PayFi 托管演示（HashKey Chain Testnet）

# 可选：用户页「新建托管合同意向」表单缺省（未设时 10 USDC / 5 期 / 1 小时）
# NEXT_PUBLIC_DEFAULT_ESCROW_USDC=10
# NEXT_PUBLIC_DEFAULT_MAX_RELEASES=5
# NEXT_PUBLIC_DEFAULT_CYCLE_HOURS=1
